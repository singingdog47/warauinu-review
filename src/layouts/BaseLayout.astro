---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '笑う犬の日々レビュー｜買ったものと試したことの記録',
  description = '映像の仕事をする会社員が、買ったもの、試したこと、お金のことを実体験から記録します。',
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <title>{title}</title>
  </head>
  <body>
    <p class="disclosure">当サイトはアフィリエイト広告を利用する予定です。現在の初期版には広告リンクを設置していません。</p>
    <header class="site-header">
      <nav class="nav shell" aria-label="メインナビゲーション">
        <a class="brand" href="/" aria-label="笑う犬の日々レビュー トップへ">笑う犬の<span>日々レビュー</span></a>
        <div class="nav-links">
          <a href="/#reviews">レビュー</a>
          <a href="/about/">このサイトについて</a>
          <a href="/policy/">運営方針</a>
        </div>
      </nav>
    </header>
    <main class="site-main"><slot /></main>
    <footer class="site-footer">
      <div class="shell">
        <strong>笑う犬の日々レビュー</strong><br />
        買ったもの。やってみたこと。お金のこと。実感のあることだけを書きます。<br />
        <small>© 2026 笑う犬の日々レビュー</small>
      </div>
    </footer>
  </body>
</html>
