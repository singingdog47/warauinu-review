{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warauinu-review",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
